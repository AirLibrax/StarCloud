# 复制本文件为 .env 并按需修改（.env 已被 gitignore，真实配置不入库）

# SQLite 数据库文件路径（相对于 prisma 目录；目录不存在时需手动创建）
DATABASE_URL="file:./data/starcloud.db"

# JWT 签名密钥。本地开发随意，公网部署前务必换成长随机串（≥32 字符），
# 泄露等于任何人可伪造任意用户的登录态。
JWT_SECRET="change-me-to-a-long-random-secret"

# 注册口令（可选功能）。语义：
#   非空            = 启用注册门禁，自助注册必须携带匹配的 inviteCode；
#   留空 / 删除本行 = 关闭，注册不做校验，前端输入框自动消失。
# 详见 README「注册口令（可选）」一节。
INVITE_CODE=""
