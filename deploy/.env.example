# ============================================================================
# StarCloud 生产环境变量
#
# 使用：
#   cp deploy/.env.example deploy/.env
#   然后编辑 deploy/.env，至少修改下面标注「必改」的三处。
# （deploy/.env 已被 git 忽略，不会提交）
# ============================================================================

# ------------------------------------------------------------
# JWT 签名密钥（必改）
# 任意足够长的随机串即可，例如服务器上运行：
#   openssl rand -hex 32
# 泄漏此值 = 任何人都能伪造登录态
# ------------------------------------------------------------
JWT_SECRET=please-change-me-to-a-long-random-string

# ------------------------------------------------------------
# 登录态有效期（可选，默认 30 天）。jsonwebtoken 时长格式：
#   30d / 12h / 60m / 7d
# ------------------------------------------------------------
# JWT_EXPIRES_IN=30d

# ------------------------------------------------------------
# SQLite 数据库位置（通常无需改动）
# 相对路径以 prisma/schema.prisma 所在目录（apps/server/prisma）为基准，
# 容器内固定解析到 /app/apps/server/prisma/data/starcloud.db，
# 由 docker-compose 的 ./data/db 卷承载
# ------------------------------------------------------------
DATABASE_URL=file:./data/starcloud.db

# ------------------------------------------------------------
# 首次初始化管理员（必改）
# 部署完成后执行一次播种（幂等，重复执行会跳过已存在账号）：
#   docker compose -f deploy/docker-compose.yml exec starcloud node dist/seed.js
# ------------------------------------------------------------
SEED_ADMIN_NAME=admin
SEED_ADMIN_PASSWORD=change-me-to-a-strong-password

# ------------------------------------------------------------
# 站点域名（必改）
# 必须已解析到本服务器公网 IP（A 记录），Caddy 将自动签发 HTTPS 证书。
# 只填域名本身，不要带 https:// 前缀
# ------------------------------------------------------------
CADDY_DOMAIN=star.example.com