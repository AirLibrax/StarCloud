{
  "name": "starcloud",
  "version": "2.0.0",
  "private": true,
  "description": "星辰云图书馆 - 全栈单体仓",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:server": "npm run start:dev --workspace @starcloud/server",
    "dev:admin": "npm run dev --workspace @starcloud/admin",
    "dev:reader": "npm run dev --workspace @starcloud/reader",
    "dev:mobile": "npm run start --workspace @starcloud/mobile",
    "build": "npm run build --workspaces --if-present"
  }
}
